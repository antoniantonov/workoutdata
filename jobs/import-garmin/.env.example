# =============================================================================
# Database backend switch
# =============================================================================
# Which data layer to load into: 'duckdb' (default) or 'postgres'.
DATABASE_TYPE=duckdb

# =============================================================================
# Garmin source / download
# =============================================================================
# Import mode:
#   delta  (default) — destination-aware missing-key sync over a look-back
#                      window; downloads/imports only data the selected
#                      destination is missing.
#   legacy           — count-based full-cache download+import (the pre-delta
#                      behavior). Selected automatically by the launcher when
#                      legacy download flags (--latest/--full-download/
#                      --activity-limit) are used.
GARMIN_IMPORT_MODE=delta
# Delta look-back window in days (positive integer). The launcher's
# --look-back-days flag overrides this; this value overrides the built-in
# default of 30. An invalid value here is an error (never silently defaulted).
GARMIN_LOOK_BACK_DAYS=30

# Compose uses the dedicated refresh-garmin-source service for live downloads;
# both database import services consume the same refreshed SQLite snapshot.
GARMIN_DOWNLOAD=false
# --- Legacy-mode download settings (ignored in delta mode) --------------------
# When downloading in legacy mode, only fetch the latest data (incremental) vs.
# everything.
GARMIN_DOWNLOAD_LATEST=true
# When true (default), a download failure aborts the job instead of silently
# falling back to existing (possibly stale) SQLite databases.
GARMIN_DOWNLOAD_REQUIRED=true

# Directory holding the GarminDB SQLite DBs (garmin_activities.db, garmin.db).
# Relative paths resolve against the job directory.
GARMIN_DB_DIR=local_data/garmin_sqlite/DBs
# GarminDB base dir (download phase writes DBs into <base>/DBs).
GARMIN_BASE_DIR=local_data/garmin_sqlite
# Config dir for the download phase (holds GarminConnectConfig.json + garth_session).
GARMIN_CONFIG_DIR=local_data/.GarminDb

# Dedicated DuckDB output file (kept separate from Polar's database_v2.duckdb).
GARMIN_DUCKDB_PATH=local_data/garmin.duckdb

# Optional download-phase tuning (legacy mode only):
# GARMIN_START_DATE=01/01/2020   # earliest date (MM/DD/YYYY) to pull sleep from
# GARMIN_DOWNLOAD_ALL_ACTIVITIES=1000
# GARMIN_DOWNLOAD_LATEST_ACTIVITIES=25
# GARMIN_DOMAIN=garmin.com

# Timezone metadata + delta calendar operations. Stored timestamps remain
# local-naive wall clock; this value is used for sleep calendar-date
# enumeration and the activity date window. Set it to the provider/account
# calendar timezone when that is not UTC.
GARMIN_LOCAL_TIMEZONE=UTC

# =============================================================================
# PostgreSQL (required when DATABASE_TYPE=postgres)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=garmin
POSTGRES_USER=garmin
POSTGRES_PASSWORD=garmin-local-only
POSTGRES_SSLMODE=disable
# Optional host port for connecting to the Compose PostgreSQL service.
GARMIN_POSTGRES_HOST_PORT=5433
# Local host port for the containerized DuckDB Web UI.
GARMIN_DUCKDB_UI_PORT=4213
# Alternatively provide a full connection string:
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/workoutdata

# =============================================================================
# Azure Storage (optional, reserved for future DuckDB upload)
# =============================================================================
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER_NAME=workout-data
