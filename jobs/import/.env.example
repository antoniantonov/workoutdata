# =============================================================================
# Polar API Configuration
# =============================================================================
POLAR_CLIENT_ID=your_client_id_here
POLAR_CLIENT_SECRET=your_client_secret_here
POLAR_REDIRECT_PORT=5000
POLAR_MEMBER_ID=your_member_id_here
ALLOW_PORT_FALLBACK=true

# =============================================================================
# Database Type Configuration
# =============================================================================
# Controls which database backend to use: 'duckdb' or 'postgres'
DATABASE_TYPE=duckdb

# =============================================================================
# File Paths Configuration (relative to repository root inside container)
# =============================================================================
# Token storage file
POLAR_TOKENS_FILE=jobs/import/tokens_polar.json

# DuckDB database path (points to the mounted local_data volume in Docker)
DUCKDB_PATH=local_data/database_v2.duckdb

# VO2max data CSV file
VO2MAX_DATA_PATH=data/v02max_data.csv

# HR zones CSV file
ZONES_CSV_PATH=hr_data/zones.csv

# Output directory for exercise files (points to mounted local_data in Docker)
OUTPUT_DIR=local_data

# =============================================================================
# Azure Storage Configuration
# =============================================================================
# When enabled in DuckDB mode, the latest duckdb/*.duckdb snapshot is restored
# from this container before the run and a new snapshot is uploaded afterwards.
AZURE_STORAGE_ENABLED=true
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER_NAME=workout-data

# =============================================================================
# PostgreSQL Database Configuration (required when DATABASE_TYPE=postgres)
# =============================================================================
# Not used by the deployed Container Apps Job, which runs in DuckDB mode.
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DATABASE=workoutdata
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# =============================================================================
# Optional Azure Service Principal (if not using Azure CLI or Managed Identity)
# =============================================================================
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
# AZURE_TENANT_ID=your_tenant_id
