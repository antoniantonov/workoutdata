# =============================================================================
# Polar API Configuration
# =============================================================================
POLAR_CLIENT_ID='fddbcde4-65b8-4e25-8c74-08cab0a76e82'
POLAR_CLIENT_SECRET='<THE CLIENT SECRET HERE>'
POLAR_REDIRECT_PORT=5001
POLAR_MEMBER_ID='<THE MEMBER ID HERE>'
ALLOW_PORT_FALLBACK=true

# =============================================================================
# File Paths Configuration
# =============================================================================
# Token storage file (relative to project root or absolute path)
POLAR_TOKENS_FILE=notebooks/tokens_polar.json

# DuckDB database path (relative to project root or absolute path)
DUCKDB_PATH=hr_data/database_v2.duckdb

# VO2max data CSV file (relative to project root or absolute path)
VO2MAX_DATA_PATH=data/v02max_data.csv

# Output directory for exercise files (relative to project root or absolute path)
OUTPUT_DIR=hr_data

# =============================================================================
# Azure Storage Account Configuration
# =============================================================================
AZURE_STORAGE_ENABLED=true
AZURE_STORAGE_ACCOUNT_NAME='muskulsa'
AZURE_STORAGE_CONTAINER_NAME='workoutdata'

# =============================================================================
# Run Testing Configuration for uploading existing workouts to Azure Storage
# =============================================================================
TEST_RUN=false
OVERWRITE_EXISTING_BLOBS=false