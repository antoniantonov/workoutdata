# =============================================================================
# Polar API Configuration
# =============================================================================
POLAR_CLIENT_ID='fddbcde4-65b8-4e25-8c74-08cab0a76e82'
POLAR_CLIENT_SECRET='<yoUr-client-secret-here>'
POLAR_REDIRECT_PORT=5001
POLAR_MEMBER_ID='<your-member-id-here>'
ALLOW_PORT_FALLBACK=true

# =============================================================================
# Database Type Configuration
# =============================================================================
# Controls which database backend to use for imports
# Valid values: 'duckdb' (default) or 'postgres'
DATABASE_TYPE=duckdb

# =============================================================================
# File Paths Configuration
# =============================================================================
# Token storage file (relative to project root or absolute path)
POLAR_TOKENS_FILE=notebooks/tokens_polar.json

# DuckDB database path (relative to project root or absolute path)
DUCKDB_PATH=hr_data/database_v2.duckdb

# VO2max data CSV file (relative to project root or absolute path)
VO2MAX_DATA_PATH=data/v02max_data.csv

# HR zones CSV file (relative to project root or absolute path)
# This file defines heart rate zones used for workout visualization and analysis
ZONES_CSV_PATH=hr_data/zones.csv

# Output directory for exercise files (relative to project root or absolute path)
OUTPUT_DIR=hr_data

# =============================================================================
# Azure Storage Account Configuration
# =============================================================================
AZURE_STORAGE_ENABLED=true
AZURE_STORAGE_ACCOUNT_NAME='muskulsa'
AZURE_STORAGE_CONTAINER_NAME='workoutdata'

# =============================================================================
# PostgreSQL Database Configuration (optional)
# =============================================================================
# Option 1: Use a full connection string (recommended for Azure PostgreSQL)
# POSTGRES_CONNECTION_STRING='postgresql://username:password@hostname:5432/workoutdata?sslmode=require'

# Option 2: Use individual connection parameters
POSTGRES_HOST='humandcoded-pg.postgres.database.azure.com'
POSTGRES_PORT=5432
POSTGRES_DATABASE='workoutdata'
POSTGRES_USER='<your-username>'
POSTGRES_PASSWORD='<your-password>'

# =============================================================================
# Run Testing Configuration for uploading existing workouts to Azure Storage
# =============================================================================
TEST_RUN=false
OVERWRITE_EXISTING_BLOBS=false